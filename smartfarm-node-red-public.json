[
  {
    "id": "public_smartfarm_tab",
    "type": "tab",
    "label": "Smartfarm (Public Reference)",
    "disabled": false,
    "info": "Credentials and environment-specific values were removed. Reference only."
  },
  {
    "id": "public_history_tab",
    "type": "tab",
    "label": "SmartFarm Hourly History (Public Reference)",
    "disabled": false,
    "info": "Creates retained hourly MQTT snapshots. No database persistence is included."
  },
  {
    "id": "public_telegram_tab",
    "type": "tab",
    "label": "Telegram Bot (Public Reference)",
    "disabled": false,
    "info": "Telegram credentials and recipient identifiers were removed."
  },
  {
    "id": "public_serial_config",
    "type": "serial-port",
    "name": "Arduino Serial (configure before use)",
    "serialport": "/dev/ttyUSB0",
    "serialbaud": "115200",
    "databits": 8,
    "parity": "none",
    "stopbits": 1,
    "waitfor": "",
    "newline": "\\n",
    "bin": "false",
    "out": "char",
    "addchar": "",
    "responsetimeout": 10000
  },
  {
    "id": "public_mqtt_config",
    "type": "mqtt-broker",
    "name": "MQTT Broker (configure before use)",
    "broker": "YOUR_MQTT_BROKER_HOST",
    "port": "8883",
    "clientid": "",
    "autoConnect": true,
    "usetls": true,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true
  },
  {
    "id": "public_telegram_config",
    "type": "telegram bot",
    "botname": "YOUR_TELEGRAM_BOT",
    "usernames": "",
    "chatids": "",
    "baseapiurl": "",
    "updatemode": "polling",
    "pollinterval": 300,
    "verboselogging": false
  },
  {
    "id": "public_serial_in",
    "type": "serial in",
    "z": "public_smartfarm_tab",
    "name": "Arduino Serial In",
    "serial": "public_serial_config",
    "x": 150,
    "y": 100,
    "wires": [["public_json"]]
  },
  {
    "id": "public_json",
    "type": "json",
    "z": "public_smartfarm_tab",
    "name": "Parse sensor JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 360,
    "y": 100,
    "wires": [["public_split_temp_humidity"]]
  },
  {
    "id": "public_split_temp_humidity",
    "type": "function",
    "z": "public_smartfarm_tab",
    "name": "Split temperature and humidity",
    "func": "return [\n    { topic: \"farm/temp\", payload: msg.payload.temp },\n    { topic: \"farm/humidity\", payload: msg.payload.humidity }\n];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 620,
    "y": 100,
    "wires": [["public_temp_out", "public_save_latest"], ["public_humidity_out", "public_save_latest"]]
  },
  {
    "id": "public_temp_out",
    "type": "mqtt out",
    "z": "public_smartfarm_tab",
    "name": "Publish temperature",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "broker": "public_mqtt_config",
    "x": 920,
    "y": 70,
    "wires": []
  },
  {
    "id": "public_humidity_out",
    "type": "mqtt out",
    "z": "public_smartfarm_tab",
    "name": "Publish humidity",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "broker": "public_mqtt_config",
    "x": 920,
    "y": 130,
    "wires": []
  },
  {
    "id": "public_save_latest",
    "type": "function",
    "z": "public_smartfarm_tab",
    "name": "Save Temp Humidity",
    "func": "if (msg.topic === \"farm/temp\") global.set(\"temperature\", msg.payload);\nif (msg.topic === \"farm/humidity\") global.set(\"humidity\", msg.payload);\nglobal.set(\"lastUpdate\", new Date().toLocaleString(\"ko-KR\"));\nreturn null;",
    "outputs": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 890,
    "y": 190,
    "wires": []
  },
  {
    "id": "public_pump_in",
    "type": "mqtt in",
    "z": "public_smartfarm_tab",
    "name": "Pump command (software logic only)",
    "topic": "farm/pump",
    "qos": "2",
    "datatype": "auto-detect",
    "broker": "public_mqtt_config",
    "x": 190,
    "y": 280,
    "wires": [["public_pump_command"]]
  },
  {
    "id": "public_pump_command",
    "type": "function",
    "z": "public_smartfarm_tab",
    "name": "Convert ON/OFF to serial command",
    "func": "const command = String(msg.payload).trim();\nif (command === \"ON\") { msg.payload = \"PUMP_ON\\n\"; return msg; }\nif (command === \"OFF\") { msg.payload = \"PUMP_OFF\\n\"; return msg; }\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 500,
    "y": 280,
    "wires": [["public_serial_out"]]
  },
  {
    "id": "public_serial_out",
    "type": "serial out",
    "z": "public_smartfarm_tab",
    "name": "Arduino Serial Out",
    "serial": "public_serial_config",
    "x": 790,
    "y": 280,
    "wires": []
  },
  {
    "id": "public_history_in",
    "type": "mqtt in",
    "z": "public_history_tab",
    "name": "Latest Temp Humidity",
    "topic": "farm/#",
    "qos": "2",
    "datatype": "auto-detect",
    "broker": "public_mqtt_config",
    "x": 180,
    "y": 100,
    "wires": [["public_store_history_values"]]
  },
  {
    "id": "public_store_history_values",
    "type": "function",
    "z": "public_history_tab",
    "name": "Store latest temp humidity",
    "func": "const value = Number(msg.payload);\nif (msg.topic === \"farm/temp\" && !Number.isNaN(value)) flow.set(\"latestTemp\", value);\nif (msg.topic === \"farm/humidity\" && !Number.isNaN(value)) flow.set(\"latestHumidity\", value);\nreturn null;",
    "outputs": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 100,
    "wires": []
  },
  {
    "id": "public_history_hourly",
    "type": "inject",
    "z": "public_history_tab",
    "name": "Every hour",
    "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}],
    "repeat": "3600",
    "crontab": "",
    "once": true,
    "onceDelay": "10",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 150,
    "y": 210,
    "wires": [["public_build_history"]]
  },
  {
    "id": "public_build_history",
    "type": "function",
    "z": "public_history_tab",
    "name": "Build hourly history snapshot",
    "func": "const temp = flow.get(\"latestTemp\");\nconst humidity = flow.get(\"latestHumidity\");\nif (temp === undefined || humidity === undefined) return null;\nconst now = new Date();\nnow.setMinutes(0, 0, 0);\nconst date = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, \"0\")}-${String(now.getDate()).padStart(2, \"0\")}`;\nconst hour = String(now.getHours()).padStart(2, \"0\");\nmsg.topic = `farm/history/${date}/${hour}`;\nmsg.payload = JSON.stringify({ ts: now.getTime(), updatedAt: Date.now(), temp, humidity });\nmsg.retain = true;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 210,
    "wires": [["public_history_out"]]
  },
  {
    "id": "public_history_out",
    "type": "mqtt out",
    "z": "public_history_tab",
    "name": "Publish retained hourly snapshot",
    "topic": "",
    "qos": "0",
    "retain": "true",
    "broker": "public_mqtt_config",
    "x": 750,
    "y": 210,
    "wires": []
  },
  {
    "id": "public_telegram_hourly",
    "type": "inject",
    "z": "public_telegram_tab",
    "name": "Hourly temperature and humidity alert",
    "props": [{"p": "payload"}],
    "repeat": "3600",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "payload": "",
    "payloadType": "date",
    "x": 190,
    "y": 120,
    "wires": [["public_telegram_message"]]
  },
  {
    "id": "public_telegram_message",
    "type": "function",
    "z": "public_telegram_tab",
    "name": "Build hourly Telegram message",
    "func": "const temp = global.get(\"temperature\");\nconst humidity = global.get(\"humidity\");\nconst lastUpdate = global.get(\"lastUpdate\");\nmsg.payload = {\n    chatId: \"YOUR_CHAT_ID\",\n    type: \"message\",\n    content: `Smart Farm status\\nTemperature: ${temp} C\\nHumidity: ${humidity}%\\nMeasured: ${lastUpdate}`\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 500,
    "y": 120,
    "wires": [["public_telegram_sender"]]
  },
  {
    "id": "public_telegram_sender",
    "type": "telegram sender",
    "z": "public_telegram_tab",
    "name": "Telegram Sender (configure before use)",
    "bot": "public_telegram_config",
    "haserroroutput": false,
    "outputs": 1,
    "x": 800,
    "y": 120,
    "wires": [[]]
  }
]
